{
  "name": "braip-figma-foundations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Code Connect (Vue) entre Braip Components no Figma e o codigo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cc:publish": "figma connect publish",
    "cc:unpublish": "figma connect unpublish",
    "cc:create": "figma connect create",
    "cc:parse": "figma connect parse",
    "figma:list": "node scripts/figma/list-components.mjs",
    "tokens:build": "node scripts/tokens/build.mjs",
    "tokens:validate": "node scripts/tokens/validate.mjs",
    "check": "npm run tokens:build && npm run tokens:validate && npm run cc:parse && npm run build"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.5.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  }
}
